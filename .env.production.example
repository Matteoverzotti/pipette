APP_NAME="Pipette"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://feedback.example.com
APP_PORT=8080

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=unibuc_feedback
DB_USERNAME=ubfeedback
DB_PASSWORD=change-me

MYSQL_DATABASE=unibuc_feedback
MYSQL_USER=ubfeedback
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

UNIBUC_ADMIN_EMAILS=
UNIBUC_LOGIN_CODE_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
